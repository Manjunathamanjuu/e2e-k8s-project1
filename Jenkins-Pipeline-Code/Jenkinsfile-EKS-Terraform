properties([
    parameters([
        string(
            defaultValue: 'variables.tfvars',
            description: 'Specify the .tfvars file name',
            name: 'File-Name'
        ),
        choice(
            choices: ['apply', 'destroy'],
            description: 'Select Terraform action',
            name: 'Terraform-Action'
        )
    ])
])

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {

        stage('Git Checkout Test') {
            steps {
                deleteDir()

                sh '''
                    set -eu

                    echo "=== Jenkins Linux Account ==="
                    whoami

                    echo "=== Check Git Installation ==="
                    command -v git
                    git --version

                    echo "=== Clone GitHub Repository ==="
                    git clone --branch master --single-branch \
                        https://github.com/Manjunathamanjuu/e2e-k8s-project1.git \
                        checkout-test

                    echo "=== Verify Repository ==="
                    git -C checkout-test status
                    git -C checkout-test log -1 --oneline

                    echo "=== Verify Terraform Directory ==="
                    test -d checkout-test/EKS-TF

                    echo "=== Checkout Successful ==="
                '''
            }
        }

        stage('Initializing Terraform') {
            steps {
                dir('checkout-test/EKS-TF') {
                    withAWS(
                        credentials: 'aws-credentials',
                        region: 'us-east-1'
                    ) {
                        sh '''
                            set -eu

                            echo "=== Check Terraform Installation ==="
                            command -v terraform
                            terraform --version

                            echo "=== Initialize Terraform ==="
                            terraform init -input=false -no-color

                            echo "=== Terraform Init Successful ==="
                        '''
                    }
                }
            }
        }

        stage('Validate Terraform Code') {
            steps {
                dir('checkout-test/EKS-TF') {
                    withAWS(
                        credentials: 'aws-credentials',
                        region: 'us-east-1'
                    ) {
                        sh '''
                            set -eu

                            echo "=== Validate Terraform ==="
                            terraform validate -no-color

                            echo "=== Validation Successful ==="
                        '''
                    }
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                dir('checkout-test/EKS-TF') {
                    withAWS(
                        credentials: 'aws-credentials',
                        region: 'us-east-1'
                    ) {
                        withEnv([
                            "TFVARS_FILE=${params['File-Name']}"
                        ]) {
                            sh '''
                                set -eu

                                tfvars="$TFVARS_FILE"

                                case "$tfvars" in
                                    ""|*[!A-Za-z0-9_.-]*)
                                        echo "ERROR: Invalid tfvars filename."
                                        exit 1
                                        ;;
                                esac

                                case "$tfvars" in
                                    *.tfvars) ;;
                                    *)
                                        echo "ERROR: Filename must end with .tfvars"
                                        exit 1
                                        ;;
                                esac

                                if [ ! -f "$tfvars" ]; then
                                    echo "ERROR: Variable file not found: $tfvars"
                                    echo "Available tfvars files:"
                                    find . -maxdepth 1 -type f -name '*.tfvars' -print
                                    exit 1
                                fi

                                echo "=== Terraform Plan ==="

                                terraform plan \
                                    -input=false \
                                    "-var-file=$tfvars" \
                                    -no-color

                                echo "=== Terraform Plan Successful ==="
                            '''
                        }
                    }
                }
            }
        }

        stage('Terraform Action') {
            steps {
                script {
                    def action = params['Terraform-Action']

                    if (!(action in ['apply', 'destroy'])) {
                        error("Invalid Terraform action: ${action}")
                    }

                    echo "Selected Terraform action: ${action}"

                    if (action == 'apply') {
                        input(
                            message: 'Confirm Terraform apply. This may create or modify AWS resources.',
                            ok: 'Apply'
                        )
                    } else {
                        input(
                            message: 'Confirm Terraform destroy. This may delete AWS resources.',
                            ok: 'Destroy'
                        )
                    }
                }

                dir('checkout-test/EKS-TF') {
                    withAWS(
                        credentials: 'aws-credentials',
                        region: 'us-east-1'
                    ) {
                        withEnv([
                            "TFVARS_FILE=${params['File-Name']}",
                            "TF_ACTION=${params['Terraform-Action']}"
                        ]) {
                            sh '''
                                set -eu

                                tfvars="$TFVARS_FILE"

                                case "$tfvars" in
                                    ""|*[!A-Za-z0-9_.-]*)
                                        echo "ERROR: Invalid tfvars filename."
                                        exit 1
                                        ;;
                                esac

                                case "$tfvars" in
                                    *.tfvars) ;;
                                    *)
                                        echo "ERROR: Filename must end with .tfvars"
                                        exit 1
                                        ;;
                                esac

                                if [ ! -f "$tfvars" ]; then
                                    echo "ERROR: Variable file not found: $tfvars"
                                    exit 1
                                fi

                                case "$TF_ACTION" in
                                    apply)
                                        echo "=== Terraform Apply ==="

                                        terraform apply \
                                            -input=false \
                                            -auto-approve \
                                            "-var-file=$tfvars" \
                                            -no-color
                                        ;;

                                    destroy)
                                        echo "=== Terraform Destroy ==="

                                        terraform destroy \
                                            -input=false \
                                            -auto-approve \
                                            "-var-file=$tfvars" \
                                            -no-color
                                        ;;

                                    *)
                                        echo "ERROR: Invalid Terraform action."
                                        exit 1
                                        ;;
                                esac

                                echo "=== Terraform Action Completed Successfully ==="
                            '''
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully.'
        }

        failure {
            echo 'Pipeline failed. Check the Jenkins Console Output for details.'
        }

        always {
            echo 'Terraform pipeline execution finished.'
        }
    }
}
