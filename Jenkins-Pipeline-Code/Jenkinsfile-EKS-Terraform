properties([
    parameters([
        string(
            defaultValue: 'variables.tfvars',
            description: 'Specify the .tfvars file name',
            name: 'File-Name'
        ),
        choice(
            choices: ['apply', 'destroy'],
            description: 'Select Terraform action',
            name: 'Terraform-Action'
        )
    ])
])

pipeline {
    agent any

    stages {

        stage('Git Checkout Test') {
            steps {
                deleteDir()

                sh '''
                    set -eu

                    echo "=== Jenkins Linux Account ==="
                    whoami

                    echo "=== Git Version ==="
                    git --version

                    echo "=== Clone GitHub Repository ==="
                    git clone --branch master --single-branch \
                        https://github.com/Manjunathamanjuu/e2e-k8s-project1.git \
                        checkout-test

                    echo "=== Verify Checkout ==="
                    git -C checkout-test status

                    echo "=== Checkout Test Successful ==="
                '''
            }
        }

        stage('Initializing Terraform') {
            steps {
                withAWS(
                    credentials: 'aws-credentials',
                    region: 'us-east-1'
                ) {
                    dir('checkout-test/EKS-TF') {
                        sh '''
                            set -eu

                            echo "=== Check Terraform Installation ==="
                            command -v terraform
                            terraform --version

                            echo "=== Initialize Terraform ==="
                            terraform init -input=false -no-color

                            echo "Terraform initialized successfully."
                        '''
                    }
                }
            }
        }

        stage('Validate Terraform Code') {
            steps {
                withAWS(
                    credentials: 'aws-credentials',
                    region: 'us-east-1'
                ) {
                    dir('checkout-test/EKS-TF') {
                        sh '''
                            set -eu

                            echo "=== Validate Terraform Code ==="
                            terraform validate -no-color

                            echo "Terraform validation successful."
                        '''
                    }
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                withAWS(
                    credentials: 'aws-credentials',
                    region: 'us-east-1'
                ) {
                    dir('checkout-test/EKS-TF') {
                        withEnv(["TFVARS_FILE=${params['File-Name']}"]) {
                            sh '''
                                set -eu

                                tfvars="$TFVARS_FILE"

                                case "$tfvars" in
                                    ""|*[!A-Za-z0-9_.-]*)
                                        echo "ERROR: Invalid tfvars filename."
                                        exit 1
                                        ;;
                                esac

                                case "$tfvars" in
                                    *.tfvars) ;;
                                    *)
                                        echo "ERROR: Filename must end with .tfvars"
                                        exit 1
                                        ;;
                                esac

                                if [ ! -f "$tfvars" ]; then
                                    echo "ERROR: Variable file not found: $tfvars"
                                    exit 1
                                fi

                                echo "=== Terraform Plan ==="
                                terraform plan \
                                    -input=false \
                                    "-var-file=$tfvars" \
                                    -no-color
                            '''
                        }
                    }
                }
            }
        }

        stage('Terraform Action') {
            steps {
                withAWS(
                    credentials: 'aws-credentials',
                    region: 'us-east-1'
                ) {
                    dir('checkout-test/EKS-TF') {
                        script {
                            def action = params['Terraform-Action']

                            echo "Selected action: ${action}"

                            if (action == 'apply') {

                                input(
                                    message: 'Confirm Terraform apply. This may create or modify AWS resources.',
                                    ok: 'Apply'
                                )

                                withEnv(["TFVARS_FILE=${params['File-Name']}"]) {
                                    sh '''
                                        set -eu

                                        tfvars="$TFVARS_FILE"

                                        case "$tfvars" in
                                            ""|*[!A-Za-z0-9_.-]*)
                                                echo "ERROR: Invalid tfvars filename."
                                                exit 1
                                                ;;
                                        esac

                                        case "$tfvars" in
                                            *.tfvars) ;;
                                            *)
                                                echo "ERROR: Filename must end with .tfvars"
                                                exit 1
                                                ;;
                                        esac

                                        if [ ! -f "$tfvars" ]; then
                                            echo "ERROR: Variable file not found: $tfvars"
                                            exit 1
                                        fi

                                        echo "=== Terraform Apply ==="

                                        terraform apply \
                                            -input=false \
                                            -auto-approve \
                                            "-var-file=$tfvars" \
                                            -no-color

                                        echo "Terraform apply successful."
                                    '''
                                }

                            } else if (action == 'destroy') {

                                input(
                                    message: 'Confirm Terraform destroy. This may delete AWS resources.',
                                    ok: 'Destroy'
                                )

                                withEnv(["TFVARS_FILE=${params['File-Name']}"]) {
                                    sh '''
                                        set -eu

                                        tfvars="$TFVARS_FILE"

                                        case "$tfvars" in
                                            ""|*[!A-Za-z0-9_.-]*)
                                                echo "ERROR: Invalid tfvars filename."
                                                exit 1
                                                ;;
                                        esac

                                        case "$tfvars" in
                                            *.tfvars) ;;
                                            *)
                                                echo "ERROR: Filename must end with .tfvars"
                                                exit 1
                                                ;;
                                        esac

                                        if [ ! -f "$tfvars" ]; then
                                            echo "ERROR: Variable file not found: $tfvars"
                                            exit 1
                                        fi

                                        echo "=== Terraform Destroy ==="

                                        terraform destroy \
                                            -input=false \
                                            -auto-approve \
                                            "-var-file=$tfvars" \
                                            -no-color

                                        echo "Terraform destroy successful."
                                    '''
                                }

                            } else {
                                error "Invalid Terraform action: ${action}"
                            }
                        }
                    }
                }
            }
        }
    }
}
