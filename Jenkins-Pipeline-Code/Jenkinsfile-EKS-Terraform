properties([
    parameters([
        string(
            defaultValue: 'variables.tfvars',
            description: 'Specify the .tfvars file name',
            name: 'File-Name'
        ),
        choice(
            choices: ['plan', apply', 'destroy'],
            description: 'Select Terraform action',
            name: 'Terraform-Action'
        )
    ])
])

pipeline {
    agent any

    stages {
        stage('Git Checkout Test') {
            steps {
                deleteDir()

                bat '''
                    @echo off
                    echo === Jenkins Windows Account ===
                    whoami

                    echo === Git Version ===
                    "C:\\Program Files\\Git\\cmd\\git.exe" --version
                    if errorlevel 1 exit /b 1

                    echo === Clone GitHub Repository ===
                    "C:\\Program Files\\Git\\cmd\\git.exe" clone --branch master --single-branch https://github.com/Manjunathamanjuu/e2e-k8s-project1.git checkout-test
                    if errorlevel 1 exit /b 1

                    echo === Verify Checkout ===
                    "C:\\Program Files\\Git\\cmd\\git.exe" -C checkout-test status
                    if errorlevel 1 exit /b 1

                    echo === Checkout Test Successful ===
                '''
            }
        }

        stage('Initializing Terraform') {
            steps {
                withAWS(
                    credentials: 'aws-credentials',
                    region: 'us-east-1'
                ) {
                    dir('checkout-test/EKS-TF') {
                        powershell '''
                            $ErrorActionPreference = 'Stop'

                            Write-Output "=== Check Terraform Installation ==="
                            $terraform = Get-Command terraform -ErrorAction SilentlyContinue

                            if (-not $terraform) {
                                throw "Terraform is not available in the Jenkins service PATH."
                            }

                            terraform --version
                            if ($LASTEXITCODE -ne 0) {
                                throw "Terraform version check failed."
                            }

                            Write-Output "=== Initialize Terraform ==="
                            terraform init -input=false -no-color

                            if ($LASTEXITCODE -ne 0) {
                                throw "Terraform initialization failed. Review the backend and provider errors above."
                            }

                            Write-Output "Terraform initialized successfully."
                        '''
                    }
                }
            }
        }

        stage('Validate Terraform Code') {
            steps {
                withAWS(
                    credentials: 'aws-credentials',
                    region: 'us-east-1'
                ) {
                    dir('checkout-test/EKS-TF') {
                        powershell '''
                            $ErrorActionPreference = 'Stop'

                            terraform validate -no-color

                            if ($LASTEXITCODE -ne 0) {
                                throw "Terraform validation failed."
                            }

                            Write-Output "Terraform validation successful."
                        '''
                    }
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                withAWS(
                    credentials: 'aws-credentials',
                    region: 'us-east-1'
                ) {
                    dir('checkout-test/EKS-TF') {
                        withEnv(["TFVARS_FILE=${params['File-Name']}"]) {
                            powershell '''
                                $ErrorActionPreference = 'Stop'
                                $tfvars = $env:TFVARS_FILE

                                if ($tfvars -notmatch '^[a-zA-Z0-9_.-]+\\.tfvars$') {
                                    throw "Invalid tfvars filename."
                                }

                                if (-not (Test-Path -LiteralPath $tfvars -PathType Leaf)) {
                                    throw "Variable file not found: $tfvars"
                                }

                                Write-Output "=== Terraform Plan ==="
                                terraform plan -input=false "-var-file=$tfvars" -no-color

                                if ($LASTEXITCODE -ne 0) {
                                    throw "Terraform plan failed."
                                }
                            '''
                        }
                    }
                }
            }
        }

        stage('Terraform Action') {
            steps {
                withAWS(
                    credentials: 'aws-credentials',
                    region: 'us-east-1'
                ) {
                    dir('checkout-test/EKS-TF') {
                        script {
                            echo "Selected action: ${params['Terraform-Action']}"

                            if (params['Terraform-Action'] == 'apply') {
                                input(
                                    message: 'Confirm Terraform apply. This may create or modify AWS resources.',
                                    ok: 'Apply'
                                )

                                withEnv(["TFVARS_FILE=${params['File-Name']}"]) {
                                    powershell '''
                                        $ErrorActionPreference = 'Stop'
                                        $tfvars = $env:TFVARS_FILE

                                        if ($tfvars -notmatch '^[a-zA-Z0-9_.-]+\\.tfvars$' -or
                                            -not (Test-Path -LiteralPath $tfvars -PathType Leaf)) {
                                            throw "Invalid or missing tfvars file."
                                        }

                                        terraform apply -input=false -auto-approve "-var-file=$tfvars" -no-color

                                        if ($LASTEXITCODE -ne 0) {
                                            throw "Terraform apply failed."
                                        }
                                    '''
                                }

                            } else if (params['Terraform-Action'] == 'destroy') {
                                input(
                                    message: 'Confirm Terraform destroy. This may delete AWS resources.',
                                    ok: 'Destroy'
                                )

                                withEnv(["TFVARS_FILE=${params['File-Name']}"]) {
                                    powershell '''
                                        $ErrorActionPreference = 'Stop'
                                        $tfvars = $env:TFVARS_FILE

                                        if ($tfvars -notmatch '^[a-zA-Z0-9_.-]+\\.tfvars$' -or
                                            -not (Test-Path -LiteralPath $tfvars -PathType Leaf)) {
                                            throw "Invalid or missing tfvars file."
                                        }

                                        terraform destroy -input=false -auto-approve "-var-file=$tfvars" -no-color

                                        if ($LASTEXITCODE -ne 0) {
                                            throw "Terraform destroy failed."
                                        }
                                    '''
                                }

                            } else {
                                error "Invalid Terraform action: ${params['Terraform-Action']}"
                            }
                        }
                    }
                }
            }
        }
    }
}
