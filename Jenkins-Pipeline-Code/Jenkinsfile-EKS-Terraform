properties([
    parameters([
        string(
            defaultValue: 'variables.tfvars',
            description: 'Specify the .tfvars file name',
            name: 'File-Name'
        ),
        choice(
            choices: ['apply', 'destroy'],
            description: 'Select Terraform action',
            name: 'Terraform-Action'
        )
    ])
])

pipeline {
    agent any

    stages {
        stage('Checkout from Git') {
            steps {
                git(
                    branch: 'master',
                    url: 'https://github.com/Manjunathamanjuu/e2e-k8s-project1.git'
                )
            }
        }

        stage('Initializing Terraform') {
            steps {
                withAWS(
                    credentials: 'aws-credentials',
                    region: 'ap-southeast-2'
                ) {
                    dir('EKS-TF') {
                        powershell '''
                            $output = & terraform init -no-color 2>&1
                            $status = $LASTEXITCODE
                            $output | ForEach-Object { Write-Output "$_" }

                            if ($status -eq 0) {
                                Write-Output "Terraform backend initialized successfully."
                                exit 0
                            }

                            $text = $output -join "`n"

                            if ($text -match "Backend configuration changed") {
                                Write-Output "Backend configuration changed. Reinitializing..."
                                & terraform init -reconfigure -no-color

                                if ($LASTEXITCODE -ne 0) {
                                    exit $LASTEXITCODE
                                }
                            }
                            else {
                                Write-Error "Terraform initialization failed."
                                exit $status
                            }
                        '''
                    }
                }
            }
        }

        stage('Validate Terraform Code') {
            steps {
                withAWS(
                    credentials: 'aws-credentials',
                    region: 'ap-southeast-2'
                ) {
                    dir('EKS-TF') {
                        powershell '''
                            & terraform validate -no-color
                            if ($LASTEXITCODE -ne 0) {
                                exit $LASTEXITCODE
                            }
                        '''
                    }
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                withAWS(
                    credentials: 'aws-credentials',
                    region: 'ap-southeast-2'
                ) {
                    dir('EKS-TF') {
                        powershell '''
                            $tfvars = $env:TFVARS_FILE

                            if ([string]::IsNullOrWhiteSpace($tfvars)) {
                                $tfvars = 'variables.tfvars'
                            }

                            if ($tfvars -notmatch '^[a-zA-Z0-9_.-]+\\.tfvars$') {
                                Write-Error "Invalid tfvars filename."
                                exit 1
                            }

                            if (-not (Test-Path -LiteralPath $tfvars)) {
                                Write-Error "Variable file not found: $tfvars"
                                exit 1
                            }

                            & terraform plan "-var-file=$tfvars" -lock=false -no-color

                            if ($LASTEXITCODE -ne 0) {
                                exit $LASTEXITCODE
                            }
                        '''
                    }
                }
            }
        }

        stage('Terraform Action') {
            steps {
                withAWS(
                    credentials: 'aws-credentials',
                    region: 'ap-southeast-2'
                ) {
                    dir('EKS-TF') {
                        script {
                            echo "Selected action: ${params['Terraform-Action']}"

                            withEnv([
                                "TFVARS_FILE=${params['File-Name']}"
                            ]) {
                                if (params['Terraform-Action'] == 'apply') {
                                    input(
                                        message: 'Confirm Terraform apply. This may create or modify AWS resources.',
                                        ok: 'Apply'
                                    )

                                    powershell '''
                                        & terraform apply -auto-approve -lock=false "-var-file=$env:TFVARS_FILE" -no-color
                                        if ($LASTEXITCODE -ne 0) {
                                            exit $LASTEXITCODE
                                        }
                                    '''
                                } else if (params['Terraform-Action'] == 'destroy') {
                                    input(
                                        message: 'Confirm Terraform destroy. This may delete AWS resources.',
                                        ok: 'Destroy'
                                    )

                                    powershell '''
                                        & terraform destroy -auto-approve -lock=false "-var-file=$env:TFVARS_FILE" -no-color
                                        if ($LASTEXITCODE -ne 0) {
                                            exit $LASTEXITCODE
                                        }
                                    '''
                                } else {
                                    error "Invalid Terraform action: ${params['Terraform-Action']}"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
